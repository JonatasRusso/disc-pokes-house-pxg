# Discord
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_GUILD_ID=your_guild_id_here
DISCORD_NOTIFY_CHANNEL_ID=your_channel_id_here
# Canal único de pokémon (opcional, usado como fallback)
DISCORD_POKEMON_CHANNEL_ID=your_pokemon_channel_id_here
# OU 3 canais por função (Tank/DPS/Sup). Se definidos, têm prioridade sobre o canal único.
DISCORD_POKEMON_CHANNEL_TANK=
DISCORD_POKEMON_CHANNEL_DPS=
DISCORD_POKEMON_CHANNEL_SUP=

# Site
SITE_URL=http://localhost:5173
API_URL=http://localhost:8000

# Auth
JWT_SECRET=change_this_to_a_random_secret

# Banco de dados (SQLite local / Postgres no Railway)
DATABASE_URL=sqlite+aiosqlite:///./discbot.db
