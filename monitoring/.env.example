# Senha do admin do Grafana (login: admin)
GF_ADMIN_PASSWORD=admin

# DSN do Postgres a monitorar (Railway: pegue em Variables -> DATABASE_URL,
# trocando o prefixo para postgresql:// e mantendo ?sslmode=require)
# Ex.: postgresql://postgres:senha@containers-us-west-1.railway.app:5432/railway?sslmode=require
PG_DSN=postgresql://user:pass@host:5432/dbname?sslmode=require
